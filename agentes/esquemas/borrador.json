{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "titular": {
      "type": "string",
      "description": "Una frase: la idea que debe quedar"
    },
    "secciones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "afirmaciones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "texto": {
                  "type": "string"
                },
                "fuente": {
                  "type": "string",
                  "description": "fichero#ruta del dato que la sostiene"
                }
              },
              "required": [
                "texto",
                "fuente"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "titulo",
          "afirmaciones"
        ],
        "additionalProperties": false
      }
    },
    "claves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hasta 4 claves accionables",
      "maxItems": 4
    },
    "dudas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lo que falta o no está claro: para el analista, no para el informe"
    }
  },
  "required": [
    "titular",
    "secciones",
    "claves",
    "dudas"
  ],
  "additionalProperties": false
}
