{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nota",
    "veredicto",
    "funciona",
    "mejoras",
    "para_notable"
  ],
  "properties": {
    "nota": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Nota global desde tu especialidad, con esta escala fija: 5 = aprobado (se usa, pero con errores que confunden); 6 = bien (sin errores graves, pero le falta hilo o claridad); 7 = notable (útil, coherente y sin errores de dato ni de lectura; quedan mejoras de pulido); 8 = notable alto (lo usaría tal cual un club profesional); 9-10 = excelente."
    },
    "veredicto": {
      "type": "string",
      "description": "Dos frases: qué es lo que más falla y qué lo arreglaría"
    },
    "funciona": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "Lo que hay que conservar"
    },
    "mejoras": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "informe",
          "donde",
          "problema",
          "propuesta",
          "ejemplo",
          "prioridad",
          "esfuerzo"
        ],
        "properties": {
          "informe": {
            "type": "string",
            "enum": [
              "partido-previa",
              "partido-post",
              "abp-previa",
              "abp-post",
              "video",
              "todos",
              "entrenamiento"
            ]
          },
          "donde": {
            "type": "string",
            "description": "Diapositiva, sección, escena o pantalla concreta"
          },
          "problema": {
            "type": "string"
          },
          "propuesta": {
            "type": "string",
            "description": "Qué cambiar, concreto y programable"
          },
          "ejemplo": {
            "type": "string",
            "description": "Cómo quedaría: el texto, el titular o la escena reescritos"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          },
          "esfuerzo": {
            "type": "string",
            "enum": [
              "pequeño",
              "medio",
              "grande"
            ]
          }
        }
      }
    },
    "para_notable": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      },
      "description": "Si tu nota es menor que 7: la lista CERRADA y MÍNIMA de cosas concretas (con su sitio) sin las cuales no le pondrías un 7. Si ya es 7 o más, vacía. No añadas nada que no sea imprescindible para el 7."
    }
  }
}
